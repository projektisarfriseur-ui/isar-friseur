# Supabase (create project at https://supabase.com → copy URL + service role key)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login secret (any strong string)
ADMIN_SECRET=
ADMIN_COOKIE_SECRET=replace-with-32-byte-random-string

# Resend (https://resend.com → API key). For dev you can use onboarding@resend.dev as FROM.
RESEND_API_KEY=
EMAIL_FROM="Isar Friseur <onboarding@resend.dev>"
EMAIL_REPLY_TO=burhan380@gmail.com
ADMIN_EMAIL=burhan380@gmail.com

# Public site URL (used in email links). Set to Vercel preview/prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cron auth (Vercel cron sets x-vercel-cron header; this is a fallback)
CRON_SECRET=replace-with-random-string
